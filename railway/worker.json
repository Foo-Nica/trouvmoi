{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "RAILPACK",
        "watchPatterns": ["app/**", "bootstrap/**", "config/**", "composer.lock", "php.ini", "railway/worker.json"]
    },
    "deploy": {
        "startCommand": "php artisan horizon",
        "restartPolicyType": "ALWAYS"
    }
}
