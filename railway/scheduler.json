{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "RAILPACK",
        "watchPatterns": ["app/**", "bootstrap/**", "config/**", "routes/console.php", "composer.lock", "railway/scheduler.json"]
    },
    "deploy": {
        "startCommand": "php artisan schedule:work",
        "restartPolicyType": "ALWAYS"
    }
}
