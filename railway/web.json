{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "RAILPACK",
        "watchPatterns": ["app/**", "bootstrap/**", "config/**", "database/**", "lang/**", "public/**", "resources/**", "routes/**", "composer.lock", "package-lock.json", "php.ini", "railway/web.json"]
    },
    "deploy": {
        "preDeployCommand": ["php artisan app:deploy"],
        "healthcheckPath": "/up",
        "healthcheckTimeout": 120,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 5
    }
}
